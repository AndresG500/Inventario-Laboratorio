---
import Layout from '../../layouts/Layout.astro';
import Campo from '../../components/Campo.astro';
import Cifra from '../../components/Cifra.astro';
import ExperienciaCard from '../../components/ExperienciaCard.astro';
import { datosDe, intentar } from '../../lib/formularios.js';
import { avisar } from '../../lib/sesion.js';

const { laboratorioDe, experienciasDeLaboratorio, equiposDeLaboratorio, resumen } = Astro.locals.inv;
const lab = laboratorioDe(Astro.params.id);
if (!lab) return Astro.rewrite('/404');

let error: string | null = null;
let errores: Record<string, string[]> = {};
let valores: Record<string, string> = { nombre: lab.nombre };

if (Astro.request.method === 'POST') {
  valores = datosDe(await Astro.request.formData(), ['nombre']);
  const r = await intentar(() => Astro.locals.api.modificar('laboratorios', lab.id, valores));
  if (r.resultado) {
    avisar(Astro.cookies, Astro.url, 'Se guardó el nuevo nombre del laboratorio.');
    return Astro.redirect(`/laboratorios/${lab.id}`);
  }
  ({ error, campos: errores } = r);
  Astro.response.status = 400;
}

const exps = experienciasDeLaboratorio(lab.id);
const r = resumen(equiposDeLaboratorio(lab.id));
---

<Layout titulo={lab.nombre}>
  <nav class="migas" aria-label="Ruta">
    <a href="/laboratorios">Laboratorios</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{lab.nombre}</span>
  </nav>

  <section class="encabezado encabezado--compacto">
    <p class="antetitulo">Laboratorio</p>
    <h1>{lab.nombre}</h1>
    {lab.hoja && <p class="encabezado__texto">Cargado desde: {lab.hoja}</p>}
    <div class="acciones">
      <a class="boton" href={`/experiencias/nueva?laboratorio=${lab.id}`}>Añadir una experiencia</a>
      {r.equipos > 0 && <a class="boton boton--secundario" href={`/inventario?lab=${lab.id}`}>Ver sus equipos en la tabla</a>}
    </div>
  </section>

  <section class="cifras cifras--compactas" aria-label="Resumen">
    <Cifra valor={exps.length} etiqueta="Experiencias" />
    <Cifra valor={r.equipos} etiqueta="Equipos" />
    <Cifra valor={r.unidades} etiqueta="Unidades" />
  </section>

  <section class="bloque">
    <div class="bloque__cabecera"><h2>Experiencias</h2></div>
    {exps.length > 0 ? (
      <div class="rejilla rejilla--exp">
        {exps.map((x) => <ExperienciaCard experiencia={x} />)}
      </div>
    ) : (
      <p>Este laboratorio aún no tiene experiencias. Usa el botón «Añadir una experiencia».</p>
    )}
  </section>

  <section class="tarjeta" style="max-width:40rem;margin-bottom:2rem">
    <h2>Cambiar el nombre</h2>
    {error && <div class="mensaje mensaje--error" role="alert"><strong>{error}</strong></div>}
    <form method="post" class="formulario">
      <Campo nombre="nombre" etiqueta="Nombre del laboratorio" requerido maxlength="150" valor={valores.nombre} errores={errores} />
      <div class="acciones">
        <button type="submit" class="boton">Guardar nombre</button>
      </div>
    </form>
  </section>

  <section class="tarjeta confirmacion">
    <h2>Eliminar este laboratorio</h2>
    <p>Se borrarán también todas sus experiencias y equipos. Antes de borrar te pediremos confirmación.</p>
    <a class="boton boton--peligro-suave" href={`/eliminar?tipo=laboratorio&id=${lab.id}`}>Eliminar laboratorio</a>
  </section>
</Layout>
